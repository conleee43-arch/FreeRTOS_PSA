# ==========================================
# Keil MDK-ARM 编译产物与调试临时文件过滤
# ==========================================
MDK-ARM/FreeRTOS_PSA/
MDK-ARM/DebugConfig/
MDK-ARM/RTE/
MDK-ARM/*.uvguix.*
MDK-ARM/*.dep
MDK-ARM/JLinkLog.txt
MDK-ARM/build_output.txt

# 通用编译输出
*.elf
*.hex
*.bin
*.map
*.axf
*.lst
*.obj
*.o
*.d
*.crf
*.lnp
*.sct
*.htm
*.dep

# 防止将独立 PSA 参考工程再次嵌入根项目
/PSA/

# ==========================================
# Python 虚拟环境与运行时缓存过滤
# ==========================================
gui/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.ipynb_checkpoints/

# ==========================================
# 个人 IDE 配置文件与操作系统垃圾过滤
# ==========================================
.vscode/
.idea/
*.suo
*.user
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ==========================================
# 临时日志与临时提取文件过滤
# ==========================================
gui/log*.txt
.tmp_docx_extract_utf8.txt
