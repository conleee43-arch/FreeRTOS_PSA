<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="CalcControlFSM">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- ==================== EXTERNAL CONTROL CELLS ==================== -->
        <!-- Reset Event -->
        <mxCell id="2" value="紧急重置事件 (RESET_FLAG)&#xa;-- 保护状态机发生跳闸/复位&#xa;-- 上位机下发 SystemReset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#660000;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        
        <!-- Safe Allowed Signal -->
        <mxCell id="3" value="安全使能判定 (safe_allowed)&#xa;-- 保护状态机处于 NORMAL&#xa;-- 2.0s 冷启动观察期结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#274e13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        
        <!-- STATE_WAIT_SAFE -->
        <mxCell id="4" value="STATE_WAIT_SAFE (安全等待)&#xa;-- 状态机起点 / 上电零电流锁定&#xa;-- 清除内阻、计数器与挂起标志&#xa;-- 物理电流 &gt;= 1.0A 时清除开路锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#664c00;fontStyle=1;strokeWidth=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="140" width="220" height="80" as="geometry" />
        </mxCell>
        
        <!-- ==================== INTERRUPTIBLE OPERATIONAL PHASE (CONTAINER) ==================== -->
        <mxCell id="500" value="可中断测量运转阶段 (Interruptible Operational Phase)" style="swimlane;startSize=30;dashed=1;dashPattern=1 4;fillColor=none;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;html=1;horizontal=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="260" width="560" height="1390" as="geometry" />
        </mxCell>
        
        <!-- STATE_SET_3A -->
        <mxCell id="5" value="STATE_SET_3A&#xa;-- 控制 DAC 阶跃输出 3.0A&#xa;-- 初始化动态判定计数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#664c00;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        
        <!-- STATE_WAIT_3A_STABLE -->
        <mxCell id="6" value="STATE_WAIT_3A_STABLE&#xa;-- 10ms 基础轮询与 100ms 分频采样&#xa;-- 差值判定: dI = |I_curr - I_prev|&#xa;-- 原地释放 CPU, 挂起待机" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#664c00;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="150" width="220" height="80" as="geometry" />
        </mxCell>
        
        <!-- Stable Check 3A (Diamond) -->
        <mxCell id="7" value="连续 5 次差值&#xa;dI &lt;= 500mA ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="270" width="220" height="80" as="geometry" />
        </mxCell>
        
        <!-- Open Circuit Check (Diamond) -->
        <mxCell id="8" value="开路检测:&#xa;当前电流 I_stable &lt; 1.0A ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="390" width="220" height="80" as="geometry" />
        </mxCell>
        
        <!-- STATE_LATCH_3A -->
        <mxCell id="9" value="STATE_LATCH_3A&#xa;-- 锁存 3A 点高精度遥测数据&#xa;-- U1 = VoOut, I1 = CoOut" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#664c00;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="510" width="220" height="70" as="geometry" />
        </mxCell>
        
        <!-- STATE_SET_2A -->
        <mxCell id="10" value="STATE_SET_2A&#xa;-- 目标阶跃电流 I_target = I1 - 1.0A&#xa;-- 软件限幅钳位在 [0.1A, 15.0A]&#xa;-- 控制 DAC 阶跃输出 I_target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#664c00;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="620" width="220" height="70" as="geometry" />
        </mxCell>
        
        <!-- STATE_WAIT_2A_STABLE -->
        <mxCell id="11" value="STATE_WAIT_2A_STABLE&#xa;-- 小跨度稳态观察期 (10000ms)&#xa;-- 支持调试命令暂停/恢复计时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#664c00;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="730" width="220" height="80" as="geometry" />
        </mxCell>
        
        <!-- Debug Pause Check (Diamond) -->
        <mxCell id="13" value="暂停判定:&#xa;收到 DebugPause2A ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=center;" vertex="1" parent="500">
          <mxGeometry x="360" y="730" width="160" height="80" as="geometry" />
        </mxCell>
        
        <!-- 10s Timer Check (Diamond) -->
        <mxCell id="12" value="观察期 10s 满 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="850" width="220" height="80" as="geometry" />
        </mxCell>
        
        <!-- STATE_LATCH_2A -->
        <mxCell id="14" value="STATE_LATCH_2A&#xa;-- 锁存 2A 点高精度遥测数据&#xa;-- U2 = VoOut, I2 = CoOut&#xa;-- 锁存 3A 点 I1 写入占位 ioc 字段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#664c00;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="970" width="220" height="70" as="geometry" />
        </mxCell>
        
        <!-- STATE_CALC_RESISTANCE -->
        <mxCell id="15" value="STATE_CALC_RESISTANCE&#xa;-- 执行内阻代数求解: R = dU / dI&#xa;-- 数据入库, 发布 [Calc] 计算报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#664c00;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="1080" width="220" height="80" as="geometry" />
        </mxCell>
        
        <!-- Dcr SNR Check (Diamond) -->
        <mxCell id="16" value="跌落差值保护:&#xa;dI = I1 - I2 &gt;= 0.2A ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="1200" width="220" height="80" as="geometry" />
        </mxCell>
        
        <!-- STATE_MONITOR -->
        <mxCell id="17" value="STATE_MONITOR (静态监控)&#xa;-- 内阻计算结束, 终点状态&#xa;-- 释放 DAC 主动阶跃控制权&#xa;-- 持续监视直到接收重置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#664c00;fontStyle=1;align=center;" vertex="1" parent="500">
          <mxGeometry x="70" y="1310" width="220" height="70" as="geometry" />
        </mxCell>
        
        <!-- ==================== EDGES (PARENT="1" FOR GLOBAL ROUTING) ==================== -->
        <!-- Safe_Allowed -> State_Wait_Safe -->
        <mxCell id="1001" value="safe_allowed == true" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- State_Wait_Safe -> State_Set_3A -->
        <mxCell id="1002" value="触发条件: safe_allowed == true" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
