        <!-- Open_Circuit_Check -> State_Latch_3A -->
        <mxCell id="1008" value="No (I_stable &gt;= 1.0A, 负载正常)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="8" target="9">
          <mxGeometry relative="1" as="geometry" />
