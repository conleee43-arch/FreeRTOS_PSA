          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- State_Wait_3A_Stable -> Stable_Check_3A -->
        <mxCell id="1004" value="100ms 分频判定" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="6" target="7">
