          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Open_Circuit_Check -> State_Wait_Safe (退回 WAIT_SAFE) -->
        <mxCell id="1007" value="Yes (I_stable &lt; 1.0A)&#xa;[异常开路, 报错并置开路锁]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="8" target="4">
          <mxGeometry relative="1" as="geometry">
