        <!-- Operational_Phase Container -> State_Wait_Safe (RESET RETREAT) -->
        <mxCell id="1021" value="紧急强制退回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="500" target="4">
